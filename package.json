{
  "name": "prosody-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --disable-warning=ExperimentalWarning --conditions=react-server scripts/seed.ts",
    "copy-audio": "node --disable-warning=ExperimentalWarning scripts/copy-audio.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && node scripts/with-local-supabase.ts node --disable-warning=ExperimentalWarning --conditions=react-server scripts/seed.ts",
    "test:unit": "node scripts/with-local-supabase.ts node --disable-warning=ExperimentalWarning --conditions=react-server --test --test-concurrency=1 \"tests/unit/*.test.ts\"",
    "test:e2e": "node scripts/with-local-supabase.ts playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.61.1",
    "supabase": "^3.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
