# Copy to .env.local. Server-only values: never prefix any of these NEXT_PUBLIC_.

# Supabase (local: `npx supabase status` prints both; hosted: Project Settings → API)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_RECORDINGS_BUCKET=recordings

# Google sign-in (optional; see README "Google sign-in and recordings")
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_URL=http://localhost:3000

# SONA survey: where to send a participant after the thank-you screen; %SURVEY_CODE% is replaced
# with their SONA id (the ?id= in the study link).
# SONA_COMPLETION_URL=
